APP_NAME=PlayOnMyTV
APP_KEY=
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=playonmytv
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

SESSION_NAME=playonmytv_session
SESSION_LIFETIME=120

LOG_CHANNEL=file
LOG_LEVEL=debug
LOG_PATH=storage/logs/app.log

MEDIA_STORAGE_PROVIDER=cloudinary
MEDIA_MAX_UPLOAD_SIZE_MB=100
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=playonmytv/media

CSRF_TOKEN_KEY=_csrf_token
